# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=life_os
DB_CONNECTION_LIMIT=10

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=life_os_super_secret_access_token_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=life_os_super_secret_refresh_token_key_2026
JWT_REFRESH_EXPIRY=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
