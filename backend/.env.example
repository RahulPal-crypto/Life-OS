# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
TRUST_PROXY=1
CORS_ORIGIN=*
RUN_MIGRATIONS_ON_STARTUP=true

# MySQL / TiDB Cloud Database Configuration
# Option A: Use individual DB_* settings (TLS auto-enabled for *.tidbcloud.com or DB_SSL=true)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=life_os
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
# DB_AUTO_CREATE_DATABASE=true
# DB_TIMEZONE=Z

# Option B: Or set DATABASE_URL (overrides DB_HOST/PORT/USER/PASSWORD/NAME; avoid /sys schema)
# DATABASE_URL=mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/life_os?ssl={"rejectUnauthorized":true}

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=life_os_super_secret_access_token_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=life_os_super_secret_refresh_token_key_2026
JWT_REFRESH_EXPIRY=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# In-App Mobile Update Metadata (auto-reads latest GitHub Release by default)
APP_GITHUB_REPO=RahulPal-crypto/Life-OS
APP_MIN_VERSION_CODE=1
APP_FORCE_UPDATE=false
# GITHUB_TOKEN=
# Optional manual override instead of GitHub Releases:
# APP_LATEST_VERSION_CODE=2
# APP_LATEST_VERSION_NAME=1.1.0
# APP_APK_DOWNLOAD_URL=https://github.com/RahulPal-crypto/Life-OS/releases/latest/download/app-release.apk
# APP_RELEASE_NOTES=Bug fixes and improvements
